<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glassfish-web-app PUBLIC
    "-//GlassFish.org//DTD GlassFish Application Server 3.1 Servlet 3.0//EN"
    "http://glassfish.org/dtds/glassfish-web-app_3_0-1.dtd">
<!--
    Pins the context root to /SWAC. Consumers reference SWAC through absolute
    paths such as /SWAC/swac/swac.js, so the name of the deployed WAR must not
    change this value.
-->
<glassfish-web-app error-url="">
    <context-root>SWAC</context-root>
</glassfish-web-app>
